# ══════════════════════════════════════════════════════════════════════════════
# settings.env — PROJECT PARAMETERS
# Safe to commit to git — no machine-specific paths here
# Change these to tune the algorithm behaviour
# ══════════════════════════════════════════════════════════════════════════════

# ── Input files (filenames only, not full paths) ───────────────────────────────
FILE_NAME=100mile_house.tif
SEEDS_FILE=seeds_combined_100mile_house.tif
OUT_POINTS_FILE=100mile_house_200_10.geojson
EDITED_FILE=100mile_house_200_10.geojson
FINAL_ROAD_LINE=final_road_line_100mile_house.geojson


# ── createSeeds: slope smoothing ───────────────────────────────────────────────
SLOPE_SMOOTH_WINDOW=51

# ── createSeeds: multiscale roughness ─────────────────────────────────────────
ROUGHNESS_SD_SMALL=5
ROUGHNESS_SD_MED=11
ROUGHNESS_SD_LARGE=21

# ── createSeeds: edge detection ────────────────────────────────────────────────
SOBEL_SIZE=5
GAUSSIAN_SIZE=21
GAUSSIAN_SIGMA=3

# ── RasterToVector: thresholding ───────────────────────────────────────────────
PROB_THRESHOLD=0.2
DO_OPENING=FALSE
OPENING_SIZE=3

# ── RasterToVector: skeleton filtering ────────────────────────────────────────
MIN_SKEL_BLOB_PX=1
MIN_COMPONENT_LEN_M=10.0

# ── RasterToVector: point thinning ────────────────────────────────────────────
MIN_SPACING_M=200.0

# ── RoadExtraction: cost surface ──────────────────────────────────────────────
COST_BARRIER_THRESHOLD_SMALL=8
COST_BARRIER_THRESHOLD_BIG=13
COST_BARRIER_VALUE=500

# ── RoadExtraction: transition matrix ─────────────────────────────────────────
TR_DIRECTIONS=16

# ── RoadExtraction: LCP chain building ────────────────────────────────────────
MAX_DISTANCE_THRESHOLD=1.5
MEAN_COST_THRESHOLD=100
MIN_SEGMENTS_PER_LINE=1

# ── Shiny app: default map view ────────────────────────────────────────────────
SHINY_DEFAULT_LNG=-123.3
SHINY_DEFAULT_LAT=49.3
SHINY_DEFAULT_ZOOM=10